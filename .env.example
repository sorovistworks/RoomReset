# Waitlist storage (server-only — never prefix with NEXT_PUBLIC_).
# Use the secret (service_role) key; the public key has no waitlist access after migration 002.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Country votes (public by design: browsers call two locked-down functions, see migration 002).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public contact address shown on /contact, /privacy and /terms.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=
